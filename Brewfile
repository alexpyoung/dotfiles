# Hand-curated: edit by hand, never `brew bundle dump`.
# scripts/update/brew reports drift between this file and the machine.
# No taps: homebrew/core and homebrew/cask are built in.

# git
brew "gh"            # GitHub CLI
brew "git-delta"     # diff pager
brew "git-lfs"       # large file storage
brew "gnupg"         # commit and tag signing
brew "pinentry-mac"  # GPG passphrase prompt
cask "1password-cli" # GPG key import in scripts/setup/git

# shell
brew "fzf"                     # fuzzy finder, Ctrl-R / Ctrl-T / Alt-C
brew "ripgrep"                 # FZF_DEFAULT_COMMAND
brew "starship"                # prompt
brew "stow"                    # links dotfiles packages
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-vi-mode"

# editor
brew "vim" # newer than macOS's, reads ~/.config/vim

# runtimes
brew "mise" # node, pnpm and per-project versions

# cli
brew "btop"       # resource monitor
brew "shellcheck" # lint shell scripts
brew "tlrc"       # tldr pages
brew "yq"         # YAML processor (v4)

# iOS / React Native
brew "aria2"    # faster xcodes downloads
brew "watchman" # file watching for Metro and Jest
brew "xcodes"   # install and switch Xcode versions

# apps
cask "1password"
cask "alfred"
cask "charles"
cask "claude"
cask "claude-code"
cask "docker-desktop"
cask "firefox"
cask "github"         # GitHub Desktop, for `git gui`
cask "google-chrome"
cask "iterm2"
cask "logi-options+"
cask "moom"
cask "protonvpn"
cask "slack"
cask "spotify"
cask "whatsapp"
