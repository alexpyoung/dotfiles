#!/usr/bin/env bash

set -eo pipefail

configure_git_user() {
    local -r GIT_EMAIL=$1
    git config --file ~/.gitconfig.local user.email "$GIT_EMAIL"
    gpg --list-secret-keys --keyid-format LONG\
        | grep -B 2 "$GIT_EMAIL"\
        | head -n1\
        | cut -d/ -f2\
        | cut -d' ' -f1\
        | xargs git config --file ~/.gitconfig.local user.signingkey
}

import_gpg_private_key() {
    local -r GIT_EMAIL=$1
    eval "$(op signin)"

    local id
    for id in $(op item list --format=json | jq -r '.[] | select(.title=="GPG Private Key") | .id'); do
        if op item get "$id" --format=json | jq -e --arg GIT_EMAIL "$GIT_EMAIL" 'any(.urls[]?; .href==$GIT_EMAIL)' >/dev/null; then
            echo -e "$(op item get "$id" --format=json | jq -r '.fields[] | select(.purpose=="PASSWORD" or .id=="password") | .value')" | gpg --import
            return
        fi
    done

    echo "No 1Password item titled \"GPG Private Key\" with url=$GIT_EMAIL found" >&2
    return 1
}

configure_gpg_agent() {
    local -r DIR=~/.gnupg
    if [[ ! -e $DIR/gpg-agent.conf ]]; then
        mkdir -p $DIR
        {
            # 30 days
            echo "default-cache-ttl 2592000"
            echo "max-cache-ttl 2592000"
        } > $DIR/gpg-agent.conf
    fi
    gpgconf --kill gpg-agent
}

main() {
    stow --verbose=2 git

    read -r -p "Enter git email: " GIT_EMAIL

    import_gpg_private_key "$GIT_EMAIL"
    configure_git_user "$GIT_EMAIL"
    configure_gpg_agent
}

main
