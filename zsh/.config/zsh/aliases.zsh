alias g=git

alias dk=docker
alias dkc='docker compose'

# Navigation (.. works via auto_cd)
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'
alias d='dirs -v' # directory stack, jump with cd -N

alias path='print -l $path'
alias size='du -h -d 1 | sort -h'
alias spd=networkQuality
alias src='exec zsh' # reload config in a fresh shell

alias shrug='echo "¯\_(ツ)_/¯" | pbcopy'
alias tflip='echo "(╯°□°)╯︵ ┻━┻" | pbcopy'
alias gimme='echo "༼ つ ◕_◕ ༽つ" | pbcopy'
